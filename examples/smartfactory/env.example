# Environment for examples/smartfactory/config.yaml. Copy, fill in, and source.

# SmartFactory's production history (Postgres).
DI_DSN=postgres://user:pass@localhost:5432/huaduan?sslmode=disable

# SmartFactory's MCP server (streamable HTTP, stateless, Bearer token).
SF_MCP_URL=https://factory.example/mcp
SF_MCP_TOKEN=change-me

# Console / API identities (auth.users).
DI_TOKEN_CONSULTANT=change-me-consultant
DI_TOKEN_APPROVER=change-me-approver

# The copilot's model (OpenAI-compatible endpoint).
LLM_BASE_URL=https://llm.example/v1
LLM_API_KEY=change-me
LLM_MODEL=change-me
